generator client {
  provider = "prisma-client-js"
  output   = "./generated/sqlite/logs"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_SQLITE_URL")
}

model Log {
  id             String   @id @default(uuid())
  status         Int?
  message        String
  detais         String?
  instance_error String
  created_at     DateTime @default(now())
  is_temp        Boolean? @default(true)

  @@map("logs")
}
