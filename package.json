{
  "name": "pizzaria_system",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start:dev": "ts-node-dev -r tsconfig-paths/register -r dotenv/config src/server.module.ts",
    "start:production": "node dist/server.module.js",
    "build": "babel src --extensions \".js,.ts\" --out-dir dist --copy-files --no-copy-ignored",
    "test": "clear && npx jest --injectGlobals false --runInBand -verbose tests/ ",
    "test:workflow": "clear && npx jest --bail --no-color --injectGlobals false --runInBand -verbose tests/ ",
    "generated:logs": "npx prisma generate --schema=prisma/sqlite/schema.prisma",
    "generated:default": "npx prisma generate --schema=prisma/postgresql/schema.prisma",
    "migratedev:default": "npx prisma migrate dev --schema=prisma/postgresql/schema.prisma",
    "migratedev:logs": "npx prisma migrate dev --schema=prisma/sqlite/schema.prisma",
    "migratedeploy:default": "npx prisma migrate deploy --schema=prisma/postgresql/schema.prisma",
    "migratedeploy:logs": "npx prisma migrate deploy --schema=prisma/sqlite/schema.prisma",
    "seed": "ts-node prisma/postgresql/seeds/index.ts"
  },
  "engines": {
    "node": "20.16.0"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "jest",
    "prisma",
    "cookies",
    "jwt"
  ],
  "author": "João Pedro",
  "license": "ISC",
  "description": "Setup v2 modules",
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "chroma-js": "^3.1.2",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "7.4.0",
    "hex-to-css-filter": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "prisma": "^6.1.0",
    "puppeteer": "^24.1.1",
    "redis": "^5.1.0",
    "socket.io": "^4.8.1",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^9.17.0",
    "@stylistic/eslint-plugin-js": "^2.12.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/chroma-js": "^3.1.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node-cron": "^3.0.11",
    "@types/streamifier": "^0.1.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
